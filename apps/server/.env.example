DATABASE_URL="sqlserver://localhost:1433;database=nexachat;user=YOUR_DB_USER;password=YOUR_DB_PASSWORD;trustServerCertificate=true;encrypt=true"

NEON_DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/nexachat?sslmode=require"
NEON_DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/nexachat?sslmode=require"

CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
PORT=4000
JWT_ACCESS_SECRET="replace-with-a-64-byte-random-hex-string"
JWT_REFRESH_SECRET="replace-with-a-different-64-byte-random-hex-string"

R2_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"
R2_BUCKET_NAME="nexachat-attachments"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
AI_RATE_LIMIT_PER_USER_PER_HOUR=20